{
  "name": "@tracebug/vue",
  "version": "0.1.0",
  "description": "One-click diagnostic capture for Laravel and Vue 3",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/vue.js",
  "module": "./dist/vue.js",
  "types": "./dist/vue.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.0"
  }
}
